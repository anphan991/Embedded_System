# Copy to .env only on a NEW installation; preserve an existing .env.
# legacy_step: firmware supplied by the user (LEFT/RIGHT/UP/DOWN/RESET).
# sequenced_hold: diagnostic firmware r3/r4/r5 (HOLD_*, STOP, telemetry).
SERVO_PROTOCOL=legacy_step

# PC running Mosquitto (must match mqtt_server in the DevKit sketch).
MQTT_BROKER=192.168.1.10
# ESP32-CAM IP, not the DevKit or PC IP.
VIDEO_SOURCE=http://192.168.1.50:81/stream
AI_FPS_LIMIT=30
POSE_MODEL_PATH=yolov8m-pose.pt
